; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="the-legends-of-interstellar"
run/main_scene="uid://dgly5igd7spk5"
config/features=PackedStringArray("4.8", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://Scripts/game_state.gd"
PauseMenu="*res://Scenes/pause_menu.tscn"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://Assets/PixelOverload_FontsBasicPack/Baskic8.otf"

